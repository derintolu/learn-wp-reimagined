{
  "$schema": "https://spacefast.com/schemas/sf.json",
  "space": "learn-wp-reimagined",
  "meta": { "title": "Learn WordPress, reimagined" },
  "index": "index.html",
  // No "fallback": unmatched paths (/wp-json, /wp-admin, /courses/, ...) must reach WordPress.
  // Keep in step with APP_ROUTES in src/pages/appRoutes.ts.
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/path/*", "destination": "/index.html" },
    { "source": "/learn/*", "destination": "/index.html" },
    { "source": "/finale", "destination": "/index.html" },
    { "source": "/finale/*", "destination": "/index.html" },
    { "source": "/connect", "destination": "/index.html" },
    { "source": "/how-it-works", "destination": "/index.html" },
    { "source": "/proposal", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/mcp-sweep", "schedule": "daily" }]
}
