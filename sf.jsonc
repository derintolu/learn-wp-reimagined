{
  "$schema": "https://spacefast.com/schemas/sf.json",
  "space": "learn-wp-reimagined",
  "meta": { "title": "Learn WordPress, reimagined" },
  "index": "index.html",
  // No "fallback": unmatched paths (/wp-json, /wp-admin, /courses/, ...) must reach WordPress.
  // /blog is the app's: it reads posts from /wp-json, since Spacefast never serves the WordPress front end.
  // Keep in step with APP_ROUTES in src/pages/appRoutes.ts.
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/path/*", "destination": "/index.html" },
    { "source": "/learn/*", "destination": "/index.html" },
    { "source": "/finale", "destination": "/index.html" },
    { "source": "/finale/*", "destination": "/index.html" },
    { "source": "/connect", "destination": "/index.html" },
    { "source": "/how-it-works", "destination": "/index.html" },
    { "source": "/proposal", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/*", "destination": "/index.html" },
    { "source": "/backend/*", "destination": "/index.html" },
    { "source": "/consent", "destination": "/index.html" },
    { "source": "/badges/*", "destination": "/index.html" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth/metadata" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth/metadata" }
  ],
  "crons": [
    { "path": "/api/mcp-sweep", "schedule": "daily" },
    { "path": "/api/lrs-drain", "schedule": "hourly" },
    { "path": "/api/sweep", "schedule": "daily" }
  ]
}
