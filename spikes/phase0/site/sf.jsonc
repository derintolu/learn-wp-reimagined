{
  "$schema": "https://spacefast.com/schemas/sf.json",
  "meta": { "title": "LWR phase 0 spike" },
  "index": "index.html",
  // No "fallback": unresolved paths (/wp-json, /wp-admin, ...) must reach WordPress.
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/learn/*", "destination": "/index.html" },
    { "source": "/path/*", "destination": "/index.html" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/wk" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/wk" }
  ]
}
