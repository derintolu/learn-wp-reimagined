# Copy to .env.server (gitignored). Server-only secrets; never import from client code.
CF_ACCOUNT_ID=
CF_AI_TOKEN=
ANTHROPIC_API_KEY=
# Bearer token for GET /api/admin/spend (the spend report). Generate a long random value.
ADMIN_TOKEN=
# Per-task JSON overrides, e.g. {"tutor":{"provider":"workers-ai","model":"…","maxTokens":700}}
AI_ROUTES=
# Name of a request header that carries a trusted visitor IP, used to key rate limits.
# Defaults to cf-connecting-ip. Leave unset on Spacefast (it passes no visitor IP), and never
# name a header the client can set itself.
TRUSTED_IP_HEADER=
# HMAC key for studio session cookies (POST /api/session). Sessions are off without it.
# Generate 32 random bytes, base64url: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_KEY=
# Ed25519 connector key for signed requests to the Learning Ledger. Generated by `npx tsx scripts/keys.ts`; never set by hand.
CONNECTOR_SIGNING_KEY=
CONNECTOR_KEY_ID=
# Public key the plugin's content-changed ping is verified with (public, not a secret).
CONNECTOR_PING_PUBLIC_KEY=
